# All optional. Set these in the environment of the process that serves roadmaps.
# ROADMAP_MODEL_ID=AnusmitaRC21/smolified-resume-analyzer   # Hugging Face model for tips
# ROADMAP_TIMEOUT_S=120      # give up on the model and show the basic roadmap after this
# ROADMAP_DEVICE=auto        # auto: GPU (NVIDIA or Apple) if it has room, else CPU; or cpu, cuda, mps
# ROADMAP_MODEL_WORKERS=1    # concurrent generations; extra requests get the basic roadmap at once
# ROADMAP_CACHE_DIR=/private/path  # opt-in disk cache (owner-only files, deleted after 24h); default is memory only
# ROADMAP_DEMO=1             # serve saved roadmaps from demo/, no model
# ROADMAP_AI=0               # skip the model, always use the basic roadmap
# RESUME_AI=0                # skip resume model assistance; otherwise follows ROADMAP_AI
# WAYPOINT_STORY_DB=/private/path/story-bank.sqlite3  # default: .local/story-bank.sqlite3

# RESUME_MODEL_ID=Qwen/Qwen3-0.6B  # local resume writer, separate from roadmap analyzer; downloads on first use
